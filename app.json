{
  "expo": {
    "name": "Pocket Trainer",
    "slug": "pokedex",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/crafted/app-icon.png",
    "scheme": "pokedex",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/crafted/app-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.reallybadnews.pockettrainer",
      "buildNumber": "11",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/crafted/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Pocket Trainer to photograph your Pokémon cards.",
          "photosPermission": "Choose a card photo for your Pokédex.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C93240",
          "image": "./assets/crafted/pokeball.png",
          "imageWidth": 150
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3117e7c1-f742-49bd-afc2-6fa9f790b0c7"
      }
    },
    "owner": "reallybadnews"
  }
}
